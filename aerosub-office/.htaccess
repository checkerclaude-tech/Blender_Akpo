# Aerosub Office — Apache rules (cPanel)
Options -Indexes
DirectoryIndex index.html

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# API: send everything under /api/ to index.php
RewriteCond %{REQUEST_URI} ^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/index.php [L,QSA]

# Protect secrets and internals
<FilesMatch "^(config\.php|\.installed)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md|log)$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^/api/lib/
RedirectMatch 403 ^/install/

# Speed: compress text files and let the browser keep scripts, styles and pictures for an hour (they carry ?v= numbers)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/manifest+json text/plain
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|svg|jpg|jpeg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Content Security Policy, REPORT-ONLY for now: the browser logs anything it would block (to /api/csp-report) but blocks nothing.
  # After a few days of real use with no unexpected reports, change "Content-Security-Policy-Report-Only" to "Content-Security-Policy" to enforce it.
  # Keep it in step with docs/security/open-items.md. Inline event attributes (onclick=) are not allowed: use the data- attributes in assets/js/handlers.js.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; manifest-src 'self'; worker-src 'self'; report-uri /api/csp-report"
  <FilesMatch "(sw\.js|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
